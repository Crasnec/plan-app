{
  "name": "plan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "keys": "node scripts/keys.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "@types/express": "^5.0.6",
    "@types/web-push": "^3.6.4"
  }
}
